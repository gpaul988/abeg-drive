# JWT signing secret for access tokens — set a strong random value in production
JWT_ACCESS_SECRET=

# Termii (SMS/OTP) — https://termii.com
TERMII_API_KEY=

# KYC provider (Prembly/Youverify/Smile Identity) for NIN/BVN + liveness
KYC_PROVIDER_API_KEY=
PREMBLY_APP_ID=

# Paystack (payments)
PAYSTACK_SECRET_KEY=

# Postgres connection string (production). Local dev uses a JSON file store
# (lib/db.ts) and does not require this variable.
DATABASE_URL=
